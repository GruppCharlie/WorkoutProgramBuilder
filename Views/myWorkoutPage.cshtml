@using System.Text.Json
@using WorkoutProgramBuilder.Business.Dto
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "mainLayout.cshtml";
    ViewData["ShowSortFavorites"] = true;
    ViewData["ShowEquipmentFilter"] = true;
    ViewData["LoadingMessage"] = "Loading workouts...";
    ViewData["EmptyMessage"] = "No workouts found. Add workouts from the Workout Generator!";
    ViewData["EmptyStateId"] = "emptyState";
    

    var workouts = ViewData["Workouts"] as List<SavedWorkoutDto> ?? [];
    
    var options = new JsonSerializerOptions 
    { 
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase 
    };
    var workoutsJson = JsonSerializer.Serialize(workouts, options);
}

<section class="">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Filters -->
        <div class="mt-8">
            @await Html.PartialAsync("_FilterBar")

            <!-- My Workouts Grid -->
            <div id="myWorkoutsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">

            </div>

            @await Html.PartialAsync("_EmptyState")
            @await Html.PartialAsync("_LoadingState")
        </div>
    </div>
</section>

<script>
    // Pass workouts data from server to JavaScript
    window.MY_WORKOUTS_DATA = @Html.Raw(workoutsJson);
</script>
<script src="/js/myWorkouts.js"></script>