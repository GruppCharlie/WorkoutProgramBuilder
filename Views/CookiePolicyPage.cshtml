@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "mainLayout.cshtml";
    var title = Model.Value<string>("pageTitle") ?? string.Empty;
    var body = Model.Value<string>("pageContent") ?? string.Empty;
}

<section>
    <div class="container px-6 py-24">

        @if (!string.IsNullOrWhiteSpace(title))
        {
            <h1>@title</h1>
        }

        <div class="page-content">
            @Html.Raw(body)
        </div>

        <div class="cookie-declaration mt-10">
            <script id="CookieDeclaration" src="https://consent.cookiebot.com/ef584194-1a0f-4495-93c6-1f8e4d0a1263/cd.js" type="text/javascript" async></script>
        </div>

    </div>
</section>

<style>
    .container {
        margin: 0 auto;
    }

    .page-content {
        line-height: 1.7;
        font-size: 1.05rem;
        color: #333;
    }

    .page-content p {
        margin-bottom: 1.2rem;
    }

    h1 {
        font-size: 1.8rem;
        font-weight: 600;
    }
</style>
