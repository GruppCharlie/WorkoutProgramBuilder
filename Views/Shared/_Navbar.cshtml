@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Globalization
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Web.Common.PublishedModels
@using CoreLink = Umbraco.Cms.Core.Models.Link
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager

@{
    var contentAtRoot = Umbraco.ContentAtRoot().ToList();
    var currentCulture = CultureInfo.CurrentCulture.Name;

    var settingsNode = contentAtRoot.FirstOrDefault(x => x.ContentType.Alias == "settings");
    var navbarLogo = settingsNode?.Value<IPublishedContent>("siteLogotype");
    var navbarLogoUrl = navbarLogo?.Url() ?? string.Empty;
    var searchPlaceholder = settingsNode?.Value<string>("searchPlaceHolderText") ?? "Search...";
    var navbarLogin = settingsNode?.Value<string>("navbarLogin") ?? "Login";
    var navbarLogout = settingsNode?.Value<string>("navbarLogoutText") ?? "Logout";
    var sidebarLinks = settingsNode?.Value<IEnumerable<Umbraco.Cms.Core.Models.Blocks.BlockListItem>>("sidebarNavigation");
    var NavbarlanguageSelector = settingsNode?.Value<IEnumerable<Umbraco.Cms.Core.Models.Blocks.BlockListItem>>("languageSelector");


    var searchNode = contentAtRoot.SelectMany(x => x.DescendantsOrSelf()).FirstOrDefault(x => x.ContentType.Alias == "searchPage");
    var searchUrl = searchNode?.Url(culture: currentCulture) ?? "/search";

    var homeNode = contentAtRoot.FirstOrDefault(x => x.ContentType.Alias == "modularPage");
    var homeUrl = homeNode?.Url(culture: currentCulture) ?? "/";

    var loginNode = contentAtRoot.SelectMany(x => x.DescendantsOrSelf()).FirstOrDefault(x => x.ContentType.Alias == "loginPage");
    var loginUrl = loginNode?.Url(culture: currentCulture) ?? "/login";

    var profileNode = contentAtRoot.SelectMany(x => x.DescendantsOrSelf()).FirstOrDefault(x => x.ContentType.Alias == "profile");
    var profileUrl = profileNode?.Url(culture: currentCulture) ?? "/profile";

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;
}

<nav class="bg-neutral-200 text-neutral-700 shadow-sm fixed top-0 left-0 right-0 z-50">
    <div class="container mx-auto px-6">
        <div class="flex items-center justify-between h-16">
            <div class="flex items-center space-x-4">
                <button id="menu-toggle" class="relative w-8 h-8 flex flex-col justify-between items-center p-1.5 focus:outline-none transition-all duration-300"
                        aria-label="Toggle menu">
                    <span class="block w-6 h-0.5 bg-neutral-700 transform transition-all duration-300 origin-center"></span>
                    <span class="block w-6 h-0.5 bg-neutral-700 transform transition-all duration-300 origin-center"></span>
                    <span class="block w-6 h-0.5 bg-neutral-700 transform transition-all duration-300 origin-center"></span>
                </button>

                <a class="hidden md:block" href="@homeUrl">
                    <img src="@navbarLogoUrl" alt="Logo" class="h-8 w-auto" />
                </a>
            </div>



            <div class="flex items-center space-x-4">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-neutral-500"></i>
                    <input type="text"
                           id="navbar-search"
                           data-search-url="@searchUrl"
                           placeholder="@searchPlaceholder"
                           class="pl-10 pr-3 py-2 rounded-md bg-neutral-200 text-neutral-800 placeholder-placeholder focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary w-48" />
                </div>
                @if (isLoggedIn)
                {
                    <a href="@profileUrl" class="bg-primary rounded-full w-10 h-10 flex items-center justify-center text-white hidden md:flex">
                        @currentMember?.UserName?.Substring(0, 1)
                    </a>
                }
                <div id="search-results" class="absolute bg-white shadow-lg rounded-md mt-2 w-64 max-h-80 overflow-y-auto hidden"></div>

                @foreach (var language in NavbarlanguageSelector ?? Enumerable.Empty<Umbraco.Cms.Core.Models.Blocks.BlockListItem>())
                {
                    var languageLink = language?.Content.Value<string>("socialMediaUrl");
                    var languageIcon = language?.Content.Value<IPublishedContent>("socialMediaIcon")?.Url();

                    if (string.IsNullOrEmpty(languageLink) || string.IsNullOrEmpty(languageIcon))
                    {
                        continue;
                    }

                    <a href="@languageLink" class="hover:text-primary transition-colors duration-200">
                        <img src="@languageIcon" alt="Social Media Icon" class="w-6 h-6" />
                    </a>
                }

                @if (!isLoggedIn)
                {
                    <a href="@loginUrl" class="text-neutral-700 font-medium hover:text-primary transition-colors">
                        @navbarLogin
                    </a>
                }
                else if (isLoggedIn)
                {
                    <form method="post" asp-controller="AuthSurface" asp-action="HandleLogout" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="text-neutral-700 font-medium hover:text-primary transition-colors bg-transparent border-none cursor-pointer">
                            @navbarLogout
                        </button>
                    </form>
                }

            </div>
        </div>
    </div>
</nav>

<div id="sidebar" class="fixed top-16 left-0 h-full w-64 bg-neutral-200 text-neutral-700 shadow-lg transform -translate-x-full transition-transform duration-300 z-40">
    <nav class="mt-4 space-y-2">
            <ul class="flex flex-col mt-4 space-y-2 px-4">
            @foreach (var linkItem in sidebarLinks ?? Enumerable.Empty<Umbraco.Cms.Core.Models.Blocks.BlockListItem>())
            {
                var sidebarToggle = linkItem.Content.Value<bool>("sidebarNavToggle");
                var sidebarNavLinks = linkItem.Content.Value<IEnumerable<CoreLink>>("sidebarNavLink");

                if (sidebarNavLinks == null || !sidebarNavLinks.Any())
                {
                    continue;
                }

                if (!isLoggedIn)
                {
                    if (sidebarToggle)
                    {
                        continue;
                    }
                }

                foreach (var link in sidebarNavLinks)
                {
                    <li>
                        <a href="@link.Url"
                           class="block px-4 py-2 text-neutral-700 hover:bg-neutral-300 hover:text-primary transition-colors duration-200 font-medium border-b border-neutral-300">
                            @link.Name
                        </a>
                    </li>
                }
            }

            </ul>
    </nav>
</div>

<div id="overlay" class="fixed inset-0 bg-black bg-opacity-30 hidden z-30 transition-opacity duration-300"></div>