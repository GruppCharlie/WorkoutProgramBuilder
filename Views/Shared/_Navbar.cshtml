@inherits UmbracoViewPageBase<IPublishedContent>
@using System.Globalization
@using CoreLink = Umbraco.Cms.Core.Models.Link
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager

@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var settingsNode = GetSettingsNode();
    
    // Navbar settings
    var navbarLogo = settingsNode?.Value<IPublishedContent>("siteLogotype");
    var navbarLogoUrl = navbarLogo?.Url() ?? string.Empty;
    var searchPlaceholder = GetTextOrFallback(settingsNode?.Value<string>("searchPlaceHolderText"), "Search...");
    var navbarLogin = GetTextOrFallback(settingsNode?.Value<string>("navbarLogin"), "Login");
    var navbarLogout = GetTextOrFallback(settingsNode?.Value<string>("navbarLogoutText"), "Logout");
    var sidebarLinks = settingsNode?.Value<IEnumerable<Umbraco.Cms.Core.Models.Blocks.BlockListItem>>("sidebarNavigation");
    var navbarLanguageSelector = settingsNode?.Value<IEnumerable<Umbraco.Cms.Core.Models.Blocks.BlockListItem>>("languageSelector");

    // Page URLs
    var searchUrl = GetPageUrl("searchPage", "/search");
    var homeUrl = GetPageUrl("modularPage", "/");
    var loginUrl = GetPageUrl("loginPage", "/login");
    var profileUrl = GetPageUrl("profile", "/profile");

    // Member authentication
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;

    // Language items
    var languageItems = ParseLanguageItems(navbarLanguageSelector);
    var currentLangItem = languageItems.FirstOrDefault(x => x.Link!.Equals($"/{currentCulture}", StringComparison.OrdinalIgnoreCase))
                      ?? languageItems.FirstOrDefault();
    var otherLangs = languageItems.Where(x => x != currentLangItem).ToList();
    
    // Get default culture from Umbraco
    var defaultCulture = Model.Root().Cultures.Keys.FirstOrDefault() ?? "en-US";
}

<nav class="bg-primaryGray text-primaryText border-b border-primaryBorder fixed top-0 left-0 right-0 z-50">
    <div class="container mx-auto px-6">
        <div class="flex items-center justify-between h-16">
            <div class="flex items-center space-x-4">
                <button id="menu-toggle" class="relative w-8 h-8 flex flex-col justify-between items-center p-1.5 focus:outline-none transition-all duration-300"
                        aria-label="Toggle menu">
                    <span class="block w-6 h-0.5 bg-primaryText transform transition-all duration-300 origin-center"></span>
                    <span class="block w-6 h-0.5 bg-primaryText transform transition-all duration-300 origin-center"></span>
                    <span class="block w-6 h-0.5 bg-primaryText transform transition-all duration-300 origin-center"></span>
                </button>

                <a class="hidden md:block" href="@homeUrl">
                    <img src="@navbarLogoUrl" alt="Logo" class="h-8 w-auto" />
                </a>
            </div>



            <div class="flex items-center space-x-4">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-primaryText"></i>
                    <input type="text"
                           id="navbar-search"
                           data-search-url="@searchUrl"
                           placeholder="@searchPlaceholder"
                           class="pl-10 pr-3 py-2 rounded-md bg-primaryGray text-primaryText placeholder-placeholder focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary w-48" />
                </div>
                @if (isLoggedIn)
                {
                    <a href="@profileUrl" class="bg-primary rounded-full w-10 h-10 flex items-center justify-center text-white hidden md:flex">
                        @currentMember?.UserName?.Substring(0, 1)
                    </a>
                }
                <div id="search-results" class="absolute bg-white shadow-lg rounded-md mt-2 w-64 max-h-80 overflow-y-auto hidden"></div>

                @if (currentLangItem != null)
                {
                    <div class="relative">
                        <button id="lang-toggle" type="button"
                                class="flex items-center space-x-2 px-2 py-1 rounded-md bg-transparent hover:bg-muted/10 focus:outline-none focus:ring-2 focus:ring-primary"
                                aria-haspopup="true" aria-expanded="false">
                            <img src="@currentLangItem.Icon" alt="@currentLangItem.Name" class="w-6 h-6 rounded-sm" />
                            @if (otherLangs.Any())
                            {
                                <svg class="w-3 h-3 text-primaryText" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                                </svg>
                            }
                        </button>

                        @if (otherLangs.Any())
                        {
                            <div id="lang-menu" class="hidden origin-top-right absolute right-0 mt-2 w-[4rem] bg-primaryGray text-primaryText rounded-md shadow-lg z-50 ring-1 ring-black ring-opacity-5">
                                <ul class="py-1">
                                    @foreach (var lang in otherLangs)
                                    {
                                        var targetCulture = lang.Link?.TrimStart('/');
                                        if (string.IsNullOrEmpty(targetCulture)) targetCulture = defaultCulture;
                                        
                                        var langUrl = Model.Url(culture: targetCulture);
                                        
                                        // Preserve query string when switching language
                                        var queryString = Context.Request.QueryString.ToString();
                                        if (!string.IsNullOrEmpty(queryString))
                                        {
                                            langUrl += queryString;
                                        }
                                        
                                        <li>
                                            <a href="@langUrl" 
                                               class="flex items-center px-3 py-2 text-sm hover:bg-muted/20 hover:text-primary transition-colors">
                                                <img src="@lang.Icon" alt="@lang.Name" class="w-5 h-5 mr-2 rounded-sm" />
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                    </div>
                }
                else
                {
                        <p>Current Lang error</p>
                }

                @foreach (var language in navbarLanguageSelector ?? [])
                {
                    var languageLink = language?.Content.Value<string>("socialMediaUrl");
                    var languageIcon = language?.Content.Value<IPublishedContent>("socialMediaIcon")?.Url();

                    if (string.IsNullOrEmpty(languageLink) || string.IsNullOrEmpty(languageIcon))
                    {
                        continue;
                    }

                    if (languageItems.Any(li => li.Link == languageLink && li.Icon == languageIcon))
                    {
                        continue;
                    }

                    <a href="@languageLink" class="hover:text-primary transition-colors duration-200">
                        <img src="@languageIcon" alt="Social Media Icon" class="w-6 h-6" />
                    </a>
                }

                @if (!isLoggedIn)
                {
                    <a href="@loginUrl" class="hidden md:block text-primaryText font-medium hover:text-primary transition-colors">
                        @navbarLogin
                    </a>
                }
                else if (isLoggedIn)
                {
                    @using (Html.BeginUmbracoForm("HandleLogout", "AuthSurface", FormMethod.Post, new { @class = "inline", id = "logoutForm" }))
                    {
                        <button type="submit"
                                class="hidden md:block text-primaryText font-medium hover:text-primary transition-colors bg-transparent border-none cursor-pointer">
                            @navbarLogout
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</nav>

<div id="sidebar" class="fixed top-16 left-0 h-full w-64 bg-primaryGray text-primaryText transform -translate-x-full transition-transform duration-300 z-40">
    <nav class="mt-4 space-y-2">
        <ul class="flex flex-col mt-4 space-y-2 px-4">
            @foreach (var linkItem in sidebarLinks ?? [])
            {
                var sidebarToggle = linkItem.Content.Value<bool>("sidebarNavToggle");
                var sidebarNavLinks = linkItem.Content.Value<IEnumerable<CoreLink>>("sidebarNavLink");

                if (sidebarNavLinks == null || !sidebarNavLinks.Any())
                {
                    continue;
                }

                if (!isLoggedIn)
                {
                    if (sidebarToggle)
                    {
                        continue;
                    }
                }

                foreach (var link in sidebarNavLinks)
                {
                    <li>
                        <a href="@link.Url"
                           class="block px-4 py-2 text-primaryText hover:bg-muted/20 hover:text-primary transition-colors duration-200 font-medium border-b border-primaryBorder">
                            @link.Name
                        </a>
                    </li>
                }
            }
            @if (isLoggedIn)
            {
            <li>
            @using (Html.BeginUmbracoForm("HandleLogout", "AuthSurface", FormMethod.Post, new { @class = "inline", id = "logoutForm" }))
            {
                <button type="submit"
                            class="w-full text-left px-4 py-2 text-primaryText hover:bg-muted/20 hover:text-primary transition-colors duration-200 font-medium border-b border-primaryBorder">
                        @navbarLogout
                </button>
            }
                </li>
            } else if (!isLoggedIn)
            {
                <li>
                    <a href="@loginUrl"
                       class="block px-4 py-2 text-primaryText hover:bg-muted/20 hover:text-primary transition-colors duration-200 font-medium border-b border-primaryBorder">
                        @navbarLogin
                    </a>
                </li>

            }
        </ul>
    </nav>
</div>

<div id="overlay" class="fixed inset-0 bg-black bg-opacity-30 hidden z-30 transition-opacity duration-300"></div>