@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Cms.Core.Web
@inject IUmbracoContextAccessor UmbracoContextAccessor
@using WorkoutProgramBuilder.Business.Helpers
@using WorkoutProgramBuilder.ViewModels
@inject WorkoutProgramBuilder.Business.Interface.IExerciseDbService _exerciseDbService
@inherits UmbracoViewPage<WorkoutExerciseCardViewModel>


@{
    var exerciseMuscles = Model.Exercise.MuscleGroups;
    var exerciseImageUrl = MuscleMapper.GenerateMuscleVisualizationUrl(exerciseMuscles);

    var exerciseName = Model.Exercise.Name;
    var firstMuscleGroup = exerciseMuscles?.FirstOrDefault();

    string? gifUrl = null;

    var searchResult = await _exerciseDbService.SearchAsync(exerciseName, 0, 1);
    var searchResultSecond = firstMuscleGroup != null
                             ? await _exerciseDbService.SearchAsync(firstMuscleGroup, 0, 1)
                             : null;

    if (searchResult?.Data != null && searchResult.Data.Any())
    {
        gifUrl = searchResult.Data.First().GifUrl;
    }
    else if (searchResultSecond?.Data != null && searchResultSecond.Data.Any())
    {
        gifUrl = searchResultSecond.Data.First().GifUrl;
    }

    var imageId = $"exerciseVisualization_{Model.ExerciseNumber}";

    var umbracoContext = UmbracoContextAccessor.GetRequiredUmbracoContext();
    var allNodes = umbracoContext.Content.GetAtRoot().SelectMany(r => r.DescendantsOrSelf());
    var workoutDetailsNode = allNodes.FirstOrDefault(x => x.ContentType.Alias == "workoutDetailsPage");

    var showMuscleVisualization = workoutDetailsNode?.Value<string>("showMuscleVisualization") ?? "Show Muscle Visualization";
    var showGif = workoutDetailsNode?.Value<string>("showGif") ?? "Show GIF";
    
}


<div class="flex-none w-[calc(33.333%-1rem)] min-w-[400px] h-[800px]">
    <div class="bg-white shadow-sm rounded-lg flex flex-col h-full overflow-hidden">
        <!-- Header Section -->
        <div class="relative p-6 bg-neutral-100 h-32 flex flex-col">
            <div class="flex items-start justify-between gap-3 mb-2">
                <h1 class="text-xl font-bold text-gray-900 line-clamp-1 flex-1">@Model.Exercise.Name</h1>
                <span class="flex-shrink-0 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm">@Model.ExerciseNumber</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Exercise.Description))
            {
                <p class="text-gray-600 text-sm line-clamp-2">@Model.Exercise.Description</p>
            }
        </div>

        <div class="p-6 flex flex-col flex-1 space-y-4 overflow-hidden">
            <div class="gif-wrapper pb-4 w-full flex flex-col items-center">
                <div class="flex justify-center mb-2">
                    @if (!string.IsNullOrWhiteSpace(gifUrl) && exerciseMuscles!.Any())
                    {
                        <button class="px-3 py-1 bg-primary hover:bg-primaryHover text-white rounded text-sm font-medium"
                                data-text-gif="@showGif"
                                data-text-muscle="@showMuscleVisualization"
                                onclick="toggleVisualization('@gifUrl', '@exerciseImageUrl', '@imageId', this)">
                            @showMuscleVisualization
                        </button>
                    }
                    else if (!string.IsNullOrWhiteSpace(gifUrl))
                    {
                        <button class="px-3 py-1 bg-primary hover:bg-primaryHover text-white rounded text-sm font-medium"
                                data-text-gif="@showGif"
                                data-text-muscle="@showMuscleVisualization"
                                onclick="toggleVisualization('@gifUrl', '@exerciseImageUrl', '@imageId', this)">
                            @showGif
                        </button>
                    }
                </div>

                <div class="relative w-full flex justify-center">
                    <div class="gif-skeleton absolute w-full h-full bg-gray-200 animate-pulse"></div>

                    <img id="@imageId"
                         src="@(!string.IsNullOrWhiteSpace(gifUrl) ? gifUrl : exerciseImageUrl)"
                         alt="@Model.Exercise.Name"
                         class="gif-image w-full h-auto max-w-[200px] opacity-0 transition-opacity duration-300" />
                </div>
            </div>



            <!-- Instructions -->
            @if (Model.Exercise.Instructions.Any())
            {
                <div class="flex flex-col">
                    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">@Model.InstructionsLabel</h3>
                    <ol class="list-decimal list-inside space-y-1 text-sm text-gray-700 max-h-44 overflow-y-auto pr-2">
                        @foreach (var instruction in Model.Exercise.Instructions)
                        {
                            <li class="pl-4 pb-1">@instruction</li>
                        }
                    </ol>
                </div>
            }

            <!-- Exercise Details (scrollable if too long) -->
            <div class="flex-1 flex flex-col overflow-y-auto space-y-3">
                <!-- Sets & Reps -->
                <div>
                    <span class="text-xs font-semibold text-gray-500 block mb-2">@Model.SetsRepsLabel</span>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-primary/20 text-primaryText rounded-full text-xs font-medium">@Model.Exercise.Sets @Model.SetsText</span>
                        <span class="px-3 py-1 bg-primary/20 text-primaryText rounded-full text-xs font-medium">@Model.Exercise.Reps @Model.RepsText</span>
                    </div>
                </div>

                @if (Model.Exercise.MuscleGroups.Any())
                {
                    <div>
                        <span class="text-xs font-semibold text-gray-500 block mb-2">@Model.MusclesLabel</span>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var muscle in Model.Exercise.MuscleGroups)
                            {
                                <span class="px-3 py-1 bg-primary/20 text-primaryText rounded-full text-xs font-medium uppercase">@muscle</span>
                            }
                        </div>
                    </div>
                }

                @if (Model.Exercise.Equipment.Any())
                {
                    <div>
                        <span class="text-xs font-semibold text-gray-500 block mb-2">@Model.EquipmentsLabel</span>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var equipment in Model.Exercise.Equipment)
                            {
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium">@equipment</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>