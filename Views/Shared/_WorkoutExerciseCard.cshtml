@using WorkoutProgramBuilder.Business.Helpers
@using WorkoutProgramBuilder.ViewModels
@model WorkoutExerciseCardViewModel

@{
    var exerciseMuscles = Model.Exercise.MuscleGroups;
    var exerciseImageUrl = MuscleMapper.GenerateMuscleVisualizationUrl(exerciseMuscles);
}

<div class="flex-none w-[calc(33.333%-1rem)] min-w-[400px] h-[800px]">
    <div class="bg-white shadow-sm rounded-lg flex flex-col h-full overflow-hidden">
        <!-- Header Section -->
        <div class="relative p-6 bg-neutral-100 h-32 flex flex-col">
            <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="text-xl font-bold text-gray-900 line-clamp-1 flex-1">@Model.Exercise.Name</h3>
                <span class="flex-shrink-0 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm">@Model.ExerciseNumber</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Exercise.Description))
            {
                <p class="text-gray-600 text-sm line-clamp-2">@Model.Exercise.Description</p>
            }
        </div>
        
        <div class="p-6 flex flex-col flex-1">
            <h5 class="text-sm font-semibold text-gray-700 mb-3">@Model.VisualizationTitle</h5>
            @if (exerciseMuscles.Any())
            {
                <div class="pb-4">
                    <div class="flex justify-center">
                        <img src="@exerciseImageUrl"
                             alt="@Model.Exercise.Name muscles"
                             class="w-full h-auto"
                             style="max-width: 200px;"/>
                    </div>
                </div>
            }

            <!-- Instructions -->
            @if (Model.Exercise.Instructions.Any())
            {
                <div class="mb-4">
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">@Model.InstructionsLabel</h4>
                    <ol class="list-decimal list-inside space-y-1 text-sm text-gray-700 max-h-44 overflow-y-auto pr-2">
                        @foreach (var instruction in Model.Exercise.Instructions)
                        {
                            <li class="pl-4 pb-1">@instruction</li>
                        }
                    </ol>
                </div>
            }

            <!-- Exercise Details -->
            <div class="space-y-3 mt-auto">
                <!-- Sets & Reps -->
                <div>
                    <span class="text-xs font-semibold text-gray-500 block mb-2">@Model.SetsRepsLabel</span>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-medium">@Model.Exercise.Sets @Model.SetsText</span>
                        <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-medium">@Model.Exercise.Reps @Model.RepsText</span>
                    </div>
                </div>
                @if (Model.Exercise.MuscleGroups.Any())
                {
                    <div>
                        <span class="text-xs font-semibold text-gray-500 block mb-2">@Model.MusclesLabel</span>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var muscle in Model.Exercise.MuscleGroups)
                            {
                                <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-medium uppercase">@muscle</span>
                            }
                        </div>
                    </div>
                }
                @if (Model.Exercise.Equipment.Any())
                {
                    <div>
                        <span class="text-xs font-semibold text-gray-500 block mb-2">@Model.EquipmentsLabel</span>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var equipment in Model.Exercise.Equipment)
                            {
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium">@equipment</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
