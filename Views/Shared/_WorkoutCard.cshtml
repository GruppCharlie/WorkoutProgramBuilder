@using WorkoutProgramBuilder.Business.Helpers
@using WorkoutProgramBuilder.ViewModels
@using System.Text.Json
@inherits UmbracoViewPage<WorkoutCardViewModel>


@foreach (var workout in Model.Workouts)
{
    var muscleGroups = workout.Muscles;
    var equipment = workout.Equipment;
    var exercises = workout.Exercises;
    var exercisesJson = JsonSerializer.Serialize(exercises);
    
    //MuscleMapper helper to get mapped muscles and image URL
    var mappedMuscles = MuscleMapper.MapToApiMuscleGroups(muscleGroups);
    var imageUrl = MuscleMapper.GenerateMuscleVisualizationUrl(muscleGroups);
    
    // Toast messages
    var toastAddToFavorites = Umbraco.GetDictionaryValue("toast.message.AddToFavorites") ?? "Added To Favorites";
    var toastRemoveFromFavorites = Umbraco.GetDictionaryValue("toast.message.RemoveFromFavorites") ?? "Removed From Favorites";
    var toastAddToMyWorkouts = Umbraco.GetDictionaryValue("toast.message.AddToMyWorkouts") ?? "Added To My Workouts";
    var toastRemoveFromMyWorkouts = Umbraco.GetDictionaryValue("toast.message.RemoveFromMyWorkouts") ?? "Removed From My Workouts";
    
    
    
    
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm transition-shadow duration-300 cursor-pointer hover:shadow-md workout-card w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]" 
         data-workout-id="@workout.WorkoutId"
         data-workout-muscles="@string.Join(",", muscleGroups)"
         data-workout-equipment="@string.Join(",", equipment)"
         onclick="navigateToWorkoutDetail('@workout.WorkoutId')">
        <!-- Workout Card Header -->
        <div class="relative p-6 bg-neutral-100 h-[200px] flex flex-col">
            
            <h1 class="text-2xl font-bold text-primaryText mb-2 pr-20 line-clamp-2">@workout.Name</h1>
            <p class="text-primaryText text-sm flex-1 line-clamp-3">@workout.Description</p>
            
            @if (exercises.Any())
            {
                <div class="mt-auto flex items-center gap-2 text-sm text-primaryText">
                    <i class="fa-solid fa-dumbbell"></i>
                    <span>@exercises.Count @Model.ExercisesText</span>
                </div>
            }

            <div class="absolute top-4 right-4 flex gap-2 z-10">
                <button type="button"
                        class="@(workout.IsInMyWorkouts ? "text-green-500" : "text-gray-400 hover:text-primary") focus:outline-none text-2xl add-to-my-workouts-btn"
                        data-workout-id="@workout.WorkoutId"
                        data-workout-name="@workout.Name"
                        data-workout-description="@workout.Description"
                        data-workout-muscles="@string.Join(",", muscleGroups)"
                        data-workout-equipment="@string.Join(",", equipment)"
                        data-workout-exercises='@exercisesJson'
                        data-toast-add-to-my-workouts="@toastAddToMyWorkouts"
                        data-toast-remove-from-my-workouts="@toastRemoveFromMyWorkouts"
                        onclick="@(workout.IsInMyWorkouts ? "removeFromMyWorkouts(event, this)" : "addToMyWorkouts(event, this)")"
                        title="@(workout.IsInMyWorkouts ? "Remove from My Workouts" : "Add to My Workouts")">
                    <i class="fa-solid @(workout.IsInMyWorkouts ? "fa-check" : "fa-plus")"></i>
                </button>
                <button type="button"
                        class="text-gray-400 hover:text-red-500 focus:outline-none text-2xl"
                        data-workout-id="@workout.WorkoutId"
                        data-workout-name="@workout.Name"
                        data-workout-description="@workout.Description"
                        data-workout-muscles="@string.Join(",", muscleGroups)"
                        data-workout-equipment="@string.Join(",", equipment)"
                        data-workout-exercises='@exercisesJson'
                        data-toast-add-to-favorites="@toastAddToFavorites"
                        data-toast-remove-from-favorites="@toastRemoveFromFavorites"
                        onclick="toggleWorkoutFavorite(event, this)"
                        title="@(workout.IsSaved ? "Remove from Favorites" : "Add to Favorites")">
                    <i class="fa-solid fa-heart @(workout.IsSaved ? "text-red-500" : "")"></i>
                </button>
            </div>
        </div>

        <!-- Muscle Visualization -->
        @if (mappedMuscles.Any())
        {
            <div class="p-6 bg-white border-t border-gray-100">
                <h2 class="text-sm font-semibold text-gray-700 mb-3">@Model.VisualizationTitle</h2>
                <div class="relative w-full gif-wrapper flex justify-center">
                    <div class="gif-skeleton absolute inset-0 bg-gray-200 animate-pulse rounded"></div>
                    <img src="@imageUrl" 
                         alt="Targeted muscles visualization" 
                         class="gif-image w-full h-auto mx-auto object-contain opacity-0 transition-opacity duration-300"
                         style="max-width: 200px;" />
                </div>
            </div>
        }

        <!-- Muscles & Equipment Tags -->
        <div class="p-6 space-y-4 border-t border-gray-100">
            @if (muscleGroups.Any())
            {
                <div>
                    <span class="text-xs font-semibold text-primaryText block mb-2">@Model.MusclesLabel</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var muscle in muscleGroups)
                        {
                            <span class="px-3 py-1 bg-primary/20 text-primaryText rounded-full text-xs font-medium">@muscle</span>
                        }
                    </div>
                </div>
            }
            
            @if (equipment.Any())
            {
                <div>
                    <span class="text-xs font-semibold text-primaryText block mb-2">@Model.EquipmentLabel</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var eq in equipment)
                        {
                            <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium">@eq</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
