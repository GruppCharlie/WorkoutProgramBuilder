@using WorkoutProgramBuilder.Business.Dto
@using WorkoutProgramBuilder.Business.Helpers
@using System.Text.Json
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var workouts = ViewData["Workouts"] as List<SavedWorkoutDto> ?? [];
}

@foreach (var workout in workouts)
{
    var muscleGroups = workout.Muscles;
    var equipment = workout.Equipment;
    var exercises = workout.Exercises;
    var exercisesJson = JsonSerializer.Serialize(exercises);
    
    //MuscleMapper helper to get mapped muscles and image URL
    var mappedMuscles = MuscleMapper.MapToApiMuscleGroups(muscleGroups);
    var imageUrl = MuscleMapper.GenerateMuscleVisualizationUrl(muscleGroups);
    
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm transition-shadow duration-300 cursor-pointer hover:shadow-md workout-card w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]" 
         data-workout-id="@workout.WorkoutId"
         data-workout-muscles="@string.Join(",", muscleGroups)"
         data-workout-equipment="@string.Join(",", equipment)"
         onclick="navigateToWorkoutDetail('@workout.WorkoutId')">
        <!-- Workout Card Header -->
        <div class="relative p-6 bg-neutral-100 h-[200px] flex flex-col">
            
            <h4 class="text-2xl font-bold text-gray-900 mb-2 pr-20 line-clamp-2">@workout.Name</h4>
            <p class="text-gray-600 text-sm flex-1 line-clamp-3">@workout.Description</p>
            
            @if (exercises.Any())
            {
                <div class="mt-auto flex items-center gap-2 text-sm text-gray-500">
                    <i class="fa-solid fa-dumbbell"></i>
                    <span>@exercises.Count exercises</span>
                </div>
            }

            <div class="absolute top-4 right-4 flex gap-2 z-10">
                <button type="button"
                        class="@(workout.IsInMyWorkouts ? "text-green-500" : "text-gray-400 hover:text-primary") focus:outline-none text-2xl add-to-my-workouts-btn"
                        data-workout-id="@workout.WorkoutId"
                        data-workout-name="@workout.Name"
                        data-workout-description="@workout.Description"
                        data-workout-muscles="@string.Join(",", muscleGroups)"
                        data-workout-equipment="@string.Join(",", equipment)"
                        data-workout-exercises='@exercisesJson'
                        onclick="@(workout.IsInMyWorkouts ? "removeFromMyWorkouts(event, this)" : "addToMyWorkouts(event, this)")"
                        title="@(workout.IsInMyWorkouts ? "Remove from My Workouts" : "Add to My Workouts")">
                    <i class="fa-solid @(workout.IsInMyWorkouts ? "fa-check" : "fa-plus")"></i>
                </button>
                <button type="button"
                        class="text-gray-400 hover:text-red-500 focus:outline-none text-2xl"
                        data-workout-id="@workout.WorkoutId"
                        data-workout-name="@workout.Name"
                        data-workout-description="@workout.Description"
                        data-workout-muscles="@string.Join(",", muscleGroups)"
                        data-workout-equipment="@string.Join(",", equipment)"
                        data-workout-exercises='@exercisesJson'
                        onclick="toggleWorkoutFavorite(event, this)"
                        title="Add to Favorites">
                    <i class="fa-solid fa-heart @(workout.IsSaved ? "text-red-500" : "")"></i>
                </button>
            </div>
        </div>

        <!-- Muscle Visualization -->
        @if (mappedMuscles.Any())
        {
            <div class="p-6 bg-white border-t border-gray-100">
                <h5 class="text-sm font-semibold text-gray-700 mb-3">Targeted Muscles Visualization</h5>
                <div class="flex justify-center">
                    <img src="@imageUrl" 
                         alt="Targeted muscles visualization" 
                         class="w-full h-auto mx-auto"
                         style="max-width: 400px;" />
                </div>
            </div>
        }

        <!-- Muscles & Equipment Tags -->
        <div class="p-6 space-y-4 border-t border-gray-100">
            @if (muscleGroups.Any())
            {
                <div>
                    <span class="text-xs font-semibold text-gray-500 block mb-2">Muscles:</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var muscle in muscleGroups)
                        {
                            <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-medium">@muscle</span>
                        }
                    </div>
                </div>
            }
            
            @if (equipment.Any())
            {
                <div>
                    <span class="text-xs font-semibold text-gray-500 block mb-2">Equipment:</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var eq in equipment)
                        {
                            <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium">@eq</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
