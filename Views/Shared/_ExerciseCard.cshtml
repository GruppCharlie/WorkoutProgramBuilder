@model WorkoutProgramBuilder.Business.Dto.ExerciseDto

<div class="flex flex-col bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">
    <div class="relative">
        <img src="@Model.GifUrl" alt="@Model.Name" class="w-full h-52 object-contain bg-gray-50" />
    </div>

    <div class="flex flex-col flex-grow p-5">
        <h3 class="font-semibold text-lg text-gray-900 mb-1 capitalize">@Model.Name</h3>

        <div class="flex flex-wrap gap-2 mb-3">
            @foreach (var bp in Model.BodyParts ?? new List<string>())
            {
                <span class="px-2 py-1 bg-primary/10 text-primary text-xs rounded-full font-medium">@bp</span>
            }
            @foreach (var tm in Model.TargetMuscles ?? new List<string>())
            {
                <span class="px-2 py-1 bg-primary/10 text-primary text-xs rounded-full font-medium">@tm</span>
            }
        </div>

        <p class="text-sm text-gray-600 mb-2">
            <span class="font-medium text-gray-700">Equipment:</span>
            @(string.Join(", ", Model.Equipments ?? new List<string>()))
        </p>

        @if (Model.SecondaryMuscles?.Any() == true)
        {
            <p class="text-sm text-gray-600 mb-3">
                <span class="font-medium text-gray-700">Secondary:</span>
                @(string.Join(", ", Model.SecondaryMuscles))
            </p>
        }
    </div>
</div>
