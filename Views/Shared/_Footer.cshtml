@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Web.Common.PublishedModels
@using CoreLink = Umbraco.Cms.Core.Models.Link

@{
    var settingsNode = Umbraco.ContentAtRoot().FirstOrDefault(x => x.ContentType.Alias == "settings");

    var FooterCompanyName = settingsNode?.Value<string>("siteName") ?? "Workout Program Builder";

    var FooterRights = settingsNode?.Value<string>("copyrightDescription") ?? "All rights reserved";

    var FooterItems = settingsNode?.Value<IEnumerable<CoreLink>>("footerItems") ?? new List<CoreLink>();

    var FooterSocialMedia = settingsNode?.Value<IEnumerable<Umbraco.Cms.Core.Models.Blocks.BlockListItem>>("socialMediaIcons") ?? null;

}

<footer class="bg-primaryGray text-primaryText py-10 border-t border-primaryBorder">
    <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">

            <div class="text-center md:text-left">
                <p class="text-xl font-semibold text-primaryText">
                    @FooterCompanyName
                </p>
                <p class="text-sm text-primaryBorder mt-2">@FooterRights</p>
            </div>

            <nav>
                <ul class="flex flex-wrap justify-center md:justify-end gap-6 text-sm font-medium">
                    @foreach (var link in FooterItems)
                    {
                        <li>
                            <a href="@link.Url"
                               target="@(string.IsNullOrWhiteSpace(link.Target) ? "_self" : link.Target)"
                               class="text-textPrimary hover:text-primary transition-colors duration-200">
                                @link.Name
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>

        <hr class="border-primaryBorder my-8" />

        <div class="flex justify-center md:justify-start items-center text-sm text-primaryText gap-4">
            @foreach (var social in FooterSocialMedia!)
            {
                var platformLink = social?.Content.Value<string>("socialMediaUrl");
                var platformIcon = social?.Content.Value<IPublishedContent>("socialMediaIcon")?.Url();

                if (string.IsNullOrEmpty(platformLink) || string.IsNullOrEmpty(platformIcon))
                {
                    continue;
                }

                <a href="@platformLink" class="hover:opacity-70 transition-colors duration-200" target="_blank">
                    <img src="@platformIcon" alt="Social Media Icon" class="w-6 h-6" />
                </a>
            }
        </div>

    </div>
</footer>
