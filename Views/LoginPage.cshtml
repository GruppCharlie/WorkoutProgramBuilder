@using System.Linq;
@using Umbraco.Cms.Core.Models.Blocks;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<LoginPage>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;

@{
	Layout = "mainLayout.cshtml";

	var all = Model.LoginForm ?? new BlockListModel(new List<BlockListItem>());
	var inputBlocks  = new BlockListModel(all.Where(x => x.Content.ContentType.Alias != "formButton").ToList());
	var buttonBlocks = new BlockListModel(all.Where(x => x.Content.ContentType.Alias == "formButton").ToList());
}

<div class="container mx-auto px-4">
    <section class="max-w-md mx-auto mt-24 bg-white rounded-2xl shadow-lg px-8 py-10">
        <form id="loginForm" class="space-y-6" novalidate autocomplete="off">
            @Html.GetBlockListHtml(inputBlocks)

            <div class="flex gap-3">
                @Html.GetBlockListHtml(buttonBlocks)
            </div>

            <div class="text-center mt-6">
                <p class="text-gray-600 mb-3">
                    Not a member? <span class="font-medium text-gray-800">Register here</span>
                </p>
                <a href="/signup" 
                class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold py-2 px-6 rounded-md shadow-md transition-colors duration-200">
                Register
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
  <script src="~/js/login-validation.js"></script>
}