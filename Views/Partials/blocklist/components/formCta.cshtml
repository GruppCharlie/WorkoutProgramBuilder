@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>

@{
    var message = Model.Content.Value<string>("messageText");
    var buttons = Model.Content.Value<Umbraco.Cms.Core.Models.Blocks.BlockListModel>("ctaButton");
    var align = Model.Content.Value<string>("align") ?? "center";

    var alignClass = align == "left"
        ? "text-left"
        : align == "right"
            ? "text-right"
            : "text-center";
}

<div class="mt-6 @alignClass">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="text-gray-600 mb-3">@message</p>
    }

    @if (buttons != null)
    {
        @Html.GetBlockListHtml(buttons)
    }
</div>