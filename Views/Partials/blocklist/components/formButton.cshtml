@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;

@{
    var buttonText = Model?.Content.Value<string>("buttonText");
    var buttonType = Model?.Content.Value<string>("buttonType");
}

<div class="inline-flex mb-0">
    <button type="@buttonType" 
            class="inline-flex items-center rounded-md bg-orange-500 px-4 py-2 text-white hover:bg-orange-600">
        @buttonText
    </button>
</div>