@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using Umbraco.Extensions;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;

@{
    var uniqueName = Model?.Content.Value<string>("uniqueName");
    var labelText = Model?.Content.Value<string>("labelText");
    var placeholderText = Model?.Content.Value<string>("placeholderText");
    var isRequired = Model.Content.Value<bool>("isRequired");
    var errorMessage = Model?.Content.Value<string>("errorMessage");

    var isConfirm = uniqueName?.ToLowerInvariant().Contains("confirm") ?? false;
    var attr = isConfirm ? "data-password-confirm" : "data-password-primary";

    var tooShortMsg = Umbraco.GetDictionaryValue("Signup.Validation.PasswordMinLength")
                      ?? "Password must be at least 6 characters long";
    var mismatchMsg = Umbraco.GetDictionaryValue("Signup.Validation.PasswordsMismatch")
                      ?? "Passwords do not match";

    var disablePwdPattern = (ViewData["DisablePasswordPattern"] as bool?) ?? false;
}

<div class="space-y-2" data-validate @Html.Raw(attr)>
    <label class="block text-gray-800" for="@uniqueName">@labelText</label>

    <input id="@uniqueName" 
           name="@uniqueName" 
           type="password" 
           placeholder="@placeholderText" 
           class="w-full rounded-md border border-gray-300 bg-gray-100 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
           autocomplete="new-password"
           @Html.Raw(!disablePwdPattern ? @"pattern=""^.{6,}$""" : "")
           @(isRequired ? "required" : null) />

    @if(isRequired && !string.IsNullOrWhiteSpace(errorMessage)) 
    {
        <span data-error="required" hidden class="text-sm text-red-600 mt-1">@errorMessage</span>
    }
    @if (!disablePwdPattern && !isConfirm)
    {
        <span data-error="pattern" hidden class="text-sm text-red-600 mt-1">@tooShortMsg</span>
    }
    @if (isConfirm) 
    {
        <span data-error="mismatch" hidden class="text-sm text-red-600 mt-1">@mismatchMsg</span>
    }
</div>