@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits UmbracoViewPage<BlockListItem>

@{
    var buttonLinkText = Model.Content.Value<string>("buttonLinkText");
    
    var buttonLinkContent = Model.Content.Value<IEnumerable<IPublishedContent>>("buttonLinkUrl")?.FirstOrDefault();
    var buttonLinkUrl = buttonLinkContent?.Url() ?? Model.Content.Value<string>("buttonLinkUrl") ?? "#";
    
    var buttonVariant = Model.Content.Value<string>("buttonVariant")?.ToLower() ?? "primary";
    
    var baseClasses = "inline-block px-6 py-4 rounded-lg font-semibold no-underline transition-all duration-200";
    
    var variantClasses = buttonVariant switch
    {
        "primary" => "bg-white text-neutral-900 shadow-sm hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 border border-transparent",
        "secondary" => "bg-neutral-800 text-white shadow-lg hover:bg-neutral-700 hover:-translate-y-0.5 hover:shadow-xl active:translate-y-0 border border-transparent",
        "outline" => "bg-transparent text-white border-2 border-white hover:bg-white hover:text-neutral-900 active:translate-y-0",
        "ghost" => "bg-transparent text-white hover:bg-white/10 active:bg-white/20",
        _ => "bg-white text-neutral-900 shadow-lg hover:-translate-y-0.5 hover:shadow-xl active:translate-y-0 border border-transparent"
    };
    
    var btnClasses = $"{baseClasses} {variantClasses}";
}

<a href="@buttonLinkUrl" title="@buttonLinkText" class="@btnClasses">@buttonLinkText</a>