@using System.Linq
@using Umbraco.Cms.Core.Models
@model IEnumerable<IPublishedContent>

@functions {
    string GetThumbUrl(IPublishedContent content, string alias = "thumbnail")
    {
        if (content == null || !content.HasProperty(alias))
            return string.Empty;

        var single = content.Value<MediaWithCrops>(alias);
        if (single != null) return single.Url() ?? string.Empty;

        var many = content.Value<IEnumerable<MediaWithCrops>>(alias);
        if (many?.Any() == true) return many.First().Url() ?? string.Empty;

        var singlePub = content.Value<IPublishedContent>(alias);
        if (singlePub != null) return singlePub.Url();

        var manyPub = content.Value<IEnumerable<IPublishedContent>>(alias);
        return manyPub?.FirstOrDefault()?.Url() ?? string.Empty;
    }
}

<div class="articles grid gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
    @foreach (var item in Model)
    {
        var imageUrl = GetThumbUrl(item);
        var preamble = item.Value<string>("preamble") ?? string.Empty;

        <a href="@item.Url()" class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-2xl h-full">
            <article class="bg-white rounded-2xl border border-neutral-200/90 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col h-full">
                <div class="relative w-full overflow-hidden" style="aspect-ratio:16/9;">
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img
                            src="@imageUrl"
                            alt="@item.Name()"
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
                    }
                    else
                    {
                        <div class="absolute inset-0 bg-gradient-to-br from-blue-300/30 to-blue-700/30"></div>
                    }
                </div>

                <div class="flex flex-col flex-1 p-5 sm:p-6">
                    <h3 class="text-lg sm:text-xl font-bold text-neutral-900 group-hover:text-blue-700 line-clamp-2 min-h-[3rem]">
                        @item.Name()
                    </h3>
                    <p class="mt-2 line-clamp-3 text-neutral-600">@preamble</p>

                    <p class="mt-2 text-neutral-600 line-clamp-3 flex-1">
                        @preamble
                    </p>

                    <div class="pt-4">
                        <span class="inline-flex items-center gap-2 text-blue-700 font-medium">
                            Read article
                            <svg class="size-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 11-1.414-1.414L13.586 10H4a1 1 0 110-2h9.586l-3.293-3.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        </span>
                    </div>
                </div>
            </article>
        </a>
    }
</div>
