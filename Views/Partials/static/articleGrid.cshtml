@using System.Linq
@using Umbraco.Cms.Core.Models
@model IEnumerable<IPublishedContent>

@{
    var firstItem = Model.FirstOrDefault();
    var isSwedish = firstItem?.Url().Contains("/sv/") ?? false;
    var readLabel = isSwedish ? "Läs artikeln" : "Read article";
}

<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var item in Model)
    {
        var title = item.Value<string>("pageTitle") ?? item.Name;
        var url = item.Url();
        var thumb = item.Value<MediaWithCrops>("thumbnail")?.Url();
        var preamble = item.Value<string>("preamble") ?? string.Empty;

        <article class="rounded-2xl overflow-hidden border border-neutral-200 shadow-sm bg-white hover:shadow-md transition-shadow">
            @if (!string.IsNullOrEmpty(thumb))
            {
                <a href="@url" class="block aspect-[16/9] overflow-hidden">
                    <img src="@thumb" alt="@title" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" decoding="async" />
                </a>
            }

            <div class="p-6">
                <h3 class="text-xl font-bold text-neutral-900 mb-3">
                    <a href="@url" class="hover:text-blue-700 transition-colors">@title</a>
                </h3>

                @if (!string.IsNullOrWhiteSpace(preamble))
                {
                    <p class="line-clamp-3 text-neutral-700 mb-4">@preamble</p>
                }

                <a href="@url" class="text-blue-700 font-medium inline-flex items-center gap-1 hover:gap-2 transition-all">
                    @readLabel <span aria-hidden="true">→</span>
                </a>
            </div>
        </article>
    }
</div>
