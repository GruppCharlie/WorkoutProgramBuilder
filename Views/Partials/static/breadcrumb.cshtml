@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.PublishedCache
@using Umbraco.Cms.Core.Routing
@using Umbraco.Cms.Core.Services.Navigation

@inject IPublishedContentCache PublishedContentCache
@inject IDocumentNavigationQueryService DocumentNavigationQueryService
@inject IPublishedUrlProvider PublishedUrlProvider

@{
    var customBreadcrumbs = ViewData["CustomBreadcrumbs"] as List<(string Name, string? Url)>;
    var selection = Model.Ancestors(PublishedContentCache, DocumentNavigationQueryService).ToArray();

    var culture = Model.GetCultureFromDomains() ?? "en";
    var isSwedish = culture.StartsWith("sv", StringComparison.OrdinalIgnoreCase) || Model.Url().Contains("/sv/");

    var homePageDisplayName = isSwedish ? "Hem" : "Home";

    var isHome = Model.Root().Id == Model.Id;
    var hideBreadcrumbs = Model.Value<bool>("hideBreadcrumbs");
}

@if (!isHome && !hideBreadcrumbs)
{
    <section class="pt-16">
        <div class="relative bg-gradient-to-b from-neutral-100 to-neutral-50 border-b border-primaryBorder py-6">
            <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
                <h1 class="text-3xl sm:text-4xl font-extrabold text-primaryText mb-3 pt-4">
                    @(ViewBag.Title ?? Model.Name)
                </h1>

                <nav class="text-sm">
                    <ol class="inline-flex items-center gap-2 ">
                        @if (customBreadcrumbs != null)
                        {
                            @* Use custom breadcrumbs from controller *@
                            @for (int i = 0; i < customBreadcrumbs.Count; i++)
                            {
                                var crumb = customBreadcrumbs[i];
                                <li>
                                    @if (crumb.Url != null)
                                    {
                                        <a href="@crumb.Url" class="text-muted underline-offset-2 hover:text-primary">@crumb.Name</a>
                                    }
                                    else
                                    {
                                        <span class="font-medium text-primary">@crumb.Name</span>
                                    }
                                </li>
                                @if (i < customBreadcrumbs.Count - 1)
                                {
                                    <li class="text-primaryText">›</li>
                                }
                            }
                        }
                        else
                        {
                            @* Use default Umbraco breadcrumbs *@
                            @foreach (var item in selection.OrderBy(x => x.Level))
                            {
                                var displayName = item.Level == 1 ? homePageDisplayName : item.Name;
                                <li>
                                    <a href="@item.Url(PublishedUrlProvider)" class="text-muted underline-offset-2 hover:text-primary">@displayName</a>
                                </li>
                                <li class="text-primaryText">›</li>
                            }
                            <li class="font-medium text-primary">@Model.Name</li>
                        }
                    </ol>
                </nav>
            </div>
        </div>
    </section>
}
