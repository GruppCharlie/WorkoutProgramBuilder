@inherits UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>

@{
  var sectionTitle = Model.Content.Value<string>("sectionTitle") ?? "";
  var sectionSubtitle = Model.Content.Value<string>("sectionSubtitle") ?? "";
  var sectionId = sectionTitle.ToLower().Trim().Replace(" ", "-");
  
  var sectionBackgroundImage = Model.Content.Value<IPublishedContent>("sectionBackgroundImage")?.Url() ?? null;
  var sectionBackgroundColor = Model.Content.Value<string>("sectionBackgroundColor") ?? "";
  var isHero = sectionTitle.Equals("Hero", StringComparison.OrdinalIgnoreCase);
  var isWorkOutArticles = sectionTitle.Equals("Work Out Articles", StringComparison.OrdinalIgnoreCase) 
                       || sectionTitle.Equals("Träningsartiklar", StringComparison.OrdinalIgnoreCase);
  var isMuscleVisualizer = sectionTitle.Contains("Muscle Group Visualizer", StringComparison.OrdinalIgnoreCase) 
                        || sectionTitle.Contains("Muskelgruppsvisualiserare", StringComparison.OrdinalIgnoreCase);
  
  // Build background style
  var bgStyle = "";
  if (!string.IsNullOrEmpty(sectionBackgroundColor))
  {
    bgStyle = $"background-color: {sectionBackgroundColor};";
  }
}

@if (isHero && !string.IsNullOrEmpty(sectionBackgroundImage))
{
  <section id="@sectionId" class="relative h-[95dvh] w-full overflow-hidden">
    <img class="absolute inset-0 w-full h-full object-cover object-left scale-[550%] md:scale-[100%] overflow-x-hidden md:object-top" src="@sectionBackgroundImage" alt="@($"{sectionTitle} background image")"/>
    
    <div class="relative z-10 container mx-auto px-6 h-full flex items-center">
      @await Html.GetBlockGridItemAreasHtmlAsync(Model)
    </div>
  </section>
}
else
{
  <section id="@sectionId" class="py-16" style="@bgStyle">
    @if (!string.IsNullOrEmpty(sectionBackgroundImage))
    {
      <img class="w-full h-auto" src="@sectionBackgroundImage" alt="@($"{sectionTitle} background image")"/>
    }

    <div class="container mx-auto px-6">
      @* Section Header *@
      @if (!string.IsNullOrEmpty(sectionSubtitle) || !string.IsNullOrEmpty(sectionTitle))
      {
        <div class="text-center mb-12">
          @if (!string.IsNullOrEmpty(sectionSubtitle))
          {
            <span class="inline-block px-4 py-1 bg-primary/20 text-primaryText text-xs font-semibold uppercase tracking-wider rounded-full mb-4">
              @sectionSubtitle
            </span>
          }
          
          @if (!string.IsNullOrEmpty(sectionTitle))
          {
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900">@sectionTitle</h2>
          }
        </div>
      }
      
        @if (isMuscleVisualizer)
        {
          @* Render all components dynamically *@
          @await Html.GetBlockGridItemAreasHtmlAsync(Model)
          
          @* Add muscle visualizer *@
          <div data-muscle-visualizer class="p-8">
            <div class="text-center py-12">
              <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto"></div>
              <p class="mt-4 text-neutral-600">Loading muscle groups...</p>
            </div>
          </div>
        }
        else if (isWorkOutArticles)
        {
          var maxArticles = Model.Content.Value<int>("maxArticles");
          if (maxArticles <= 0) maxArticles = 3;
          ViewData["maxArticles"] = maxArticles;
          @await Html.PartialAsync("~/Views/Partials/static/workOutArticles.cshtml")
        }
        else
        {
          <div class="block-grid-with-spacing">
            @await Html.GetBlockGridItemAreasHtmlAsync(Model)
          </div>
        }
    </div>
  </section>
}

