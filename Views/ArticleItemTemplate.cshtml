@using Umbraco.Cms.Core.Models
@using System.Linq
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "mainLayout.cshtml";

    var pageTitle = Model.Value<string>("pageTitle") ?? Model.Name;
    var preamble = Model.Value<string>("preamble") ?? string.Empty;
    var thumbnail = Model.Value<MediaWithCrops>("thumbnail")?.Url() ?? string.Empty;
    var body = Model.Value<string>("pageContent") ?? string.Empty;

    var culture = Model.GetCultureFromDomains();
    var isSwedish = (culture != null && culture.StartsWith("sv", StringComparison.OrdinalIgnoreCase)) 
                    || Model.Url().Contains("/sv/");

    var labelPrevious = isSwedish ? "Föregående" : "Previous";
    var labelNext = isSwedish ? "Nästa" : "Next";

    var parent = Model.Parent<IPublishedContent>();
    var siblings = parent?.ChildrenOfType("articleItemTemplate")
        ?.Where(x => x.IsVisible())
        .OrderBy(x => x.CreateDate)
        .ToList() ?? [];

    var i = siblings.FindIndex(x => x.Id == Model.Id);
    var prev = i > 0 ? siblings[i - 1] : null;
    var next = (i >= 0 && i < siblings.Count - 1) ? siblings[i + 1] : null;

    string GetThumb(IPublishedContent? content)
    {
        if (content == null) return string.Empty;
        return content.Value<MediaWithCrops>("thumbnail")?.Url()
            ?? content.Value<IPublishedContent>("thumbnail")?.Url()
            ?? string.Empty;
    }
}

@if (!string.IsNullOrWhiteSpace(preamble))
{
  <section class="py-6">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-lg text-neutral-700">@preamble</p>
    </div>
  </section>
}

<main class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pt-10 pb-10">
  @if (!string.IsNullOrWhiteSpace(thumbnail))
  {
    <figure class="mb-8">
      <img src="@thumbnail" alt="@pageTitle" class="w-full h-auto rounded-xl shadow-sm block" />
    </figure>
  }

  <article class="rte-content">
    @Html.Raw(body)
  </article>
</main>

@if (prev != null || next != null)
{
<section aria-label="Article pagination" class="border-t border-primaryBorder bg-white/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid gap-4 sm:grid-cols-2">

      @if (prev != null)
      {
        var pThumb = GetThumb(prev);
        <a href="@prev.Url()" class="group block rounded-2xl border border-primaryBorder bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-4">
            @if (!string.IsNullOrEmpty(pThumb))
            { <img src="@pThumb" alt="@prev.Name" class="h-16 w-24 rounded-lg object-cover" loading="lazy" decoding="async" /> }
            <div class="min-w-0">
              <div class="text-xs uppercase tracking-wide text-muted">@labelPrevious</div>
              <div class="mt-0.5 line-clamp-2 font-semibold text-primaryText group-hover:text-primary">@prev.Name</div>
            </div>
          </div>
        </a>
      }

      @if (next != null)
      {
        var nThumb = GetThumb(next);
                    <a href="@next.Url()" class="group block rounded-2xl border border-primaryBorder bg-white p-4 shadow-sm hover:shadow-md transition-shadow sm:ml-auto">
          <div class="flex items-center gap-4 justify-end">
            <div class="min-w-0 text-right">
              <div class="text-xs uppercase tracking-wide text-muted">@labelNext</div>
              <div class="mt-0.5 line-clamp-2 font-semibold text-primaryText group-hover:text-primary">@next.Name</div>
            </div>
            @if (!string.IsNullOrEmpty(nThumb))
            { <img src="@nThumb" alt="@next.Name" class="h-16 w-24 rounded-lg object-cover" loading="lazy" decoding="async" /> }
          </div>
        </a>
      }

    </div>
  </div>
</section>
}

<style>
.rte-content img{max-width:100%;height:auto;display:block;border-radius:8px;margin:1rem 0}
.rte-content p{margin:0 0 16px;line-height:1.7;color:#1f2937;text-align:justify}
.rte-content h2,.rte-content h3,.rte-content h4,.rte-content h5,.rte-content h6{margin:24px 0 10px;font-weight:800;line-height:1.25;color:#111827}
.rte-content h2{font-size:1.65rem}
.rte-content h3{font-size:1.3rem}
.rte-content ul,.rte-content ol{margin:0 0 16px 1.2rem;line-height:1.7}
.rte-content li{margin:.18rem 0}
.rte-content hr{border:none;border-top:1px solid #e5e7eb;margin:28px 0}
main{scroll-margin-top:100px}
</style>
