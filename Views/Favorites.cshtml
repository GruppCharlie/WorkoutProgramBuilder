@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "mainLayout.cshtml";
    var exercises = ViewData["Exercises"] as List<WorkoutProgramBuilder.Business.Dto.ExerciseDto>;
    var workouts = ViewData["Workouts"] as List<WorkoutProgramBuilder.Business.Dto.SavedWorkoutDto>;

    var favoritesHeadline = Model.Value("favoritesHeadline");
    var noFavorites = Model.Value("noFavorites");
    
    var hasExercises = exercises != null && exercises.Any();
    var hasWorkouts = workouts != null && workouts.Any();
}

<section class="container px-6 mx-auto py-10">
    <h1 class="text-2xl font-semibold mb-6">@favoritesHeadline</h1>

    @if (!hasExercises && !hasWorkouts)
    {
        <p class="text-gray-500">@noFavorites</p>
    }
    else
    {
        @* Saved Workouts Section *@
        @if (hasWorkouts)
        {
            <div class="mb-10">
                <h2 class="text-xl font-semibold mb-4">Saved Workouts</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @await Html.PartialAsync("_WorkoutCard")
                </div>
            </div>
        }

        @* Saved Exercises Section *@
        @if (hasExercises)
        {
            <div>
                <h2 class="text-xl font-semibold mb-4">Saved Exercises</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                    @await Html.PartialAsync("_ExerciseCard")
                </div>
            </div>
        }
    }
</section>
