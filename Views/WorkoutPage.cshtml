@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "mainLayout.cshtml";
    
    var isSwedish = Model.Url().Contains("/sv/");
    
    var defaultTitle = isSwedish ? "Muskelgruppsvisualiserare" : "Muscle Group Visualizer";
    var defaultSubtitle = isSwedish 
        ? "Välj muskelgrupper för att se vilka muskler du tränar" 
        : "Select muscle groups to see which muscles you'll be training";
    
    ViewBag.Title = Model.Value<string>("pageTitle") ?? defaultTitle;
    var pageTitle = Model.Value<string>("pageTitle") ?? defaultTitle;
    var pageSubtitle = Model.Value<string>("pageSubtitle") ?? defaultSubtitle;
}

<section class="py-16 bg-white">
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Page Header -->
        <div class="text-center m-10">
            <h1 class="text-3xl md:text-4xl font-extrabold text-neutral-900 mb-4">
                @pageTitle
            </h1>
            <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
                @pageSubtitle
            </p>
        </div>

        <!-- Muscle Group Visualizer -->
        <div data-muscle-visualizer class="p-8">
            <div class="text-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
                <p class="mt-4 text-neutral-600">Loading muscle groups...</p>
            </div>
        </div>
    </div>
</section>