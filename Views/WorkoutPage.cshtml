@using WorkoutProgramBuilder.ViewModels
@inherits UmbracoViewPageBase<IPublishedContent>

@{
    Layout = "mainLayout.cshtml";
    
    var workoutGeneratorUrl = GetPageUrl("workoutGeneratorPage", "/workouts/generator");
    
    
    // Get localized texts from Dictionary
    var comingSoonTitle = Umbraco.GetDictionaryValue("workoutTemplates.comingSoon.title") ?? "Workout Templates Coming Soon!";
    var generatorText = Umbraco.GetDictionaryValue("workoutTemplates.comingSoon.generator") ?? "AI Workout Generator";
    var descriptionText = Umbraco.GetDictionaryValue("workoutTemplates.comingSoon.description") ?? "For now, try our {0} to create custom workouts!";
}

<section class="">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mt-8">
            @* Placeholder for CMS workout templates *@
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
            {
                Icon = "fa-dumbbell",
                Title = comingSoonTitle,
                Description = string.Format(descriptionText,
                    $"<a href=\"{workoutGeneratorUrl}\" class=\"text-primary hover:underline\">{generatorText}</a>")
            })

            @await Html.PartialAsync("_LoadingState")
        </div>
    </div>
</section>