@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ExercisePage>
@{
    Layout = "mainLayout.cshtml";

    var exercise = ViewData["Exercise"] as WorkoutProgramBuilder.Business.Dto.ExerciseDto;

    var titleFallback = Model.Title;
    var bodyPartsLabel = Model.BodyParts;
    var targetMusclesLabel = Model.TargetMuscles;
    var equipmentLabel = Model.Equipment;
    var secondaryMusclesLabel = Model.SecondaryMuscles;
    var instructionsLabel = Model.Instructions;
    var notAvailable = Model.NotAvailable;

    var instructions = exercise?.Instructions ?? [];
}

<div class="container mx-auto px-6 py-16">
    <div class="bg-white border border-gray-200 shadow-md rounded-2xl pt-10 max-w-6xl mx-auto">

        <h1 class="text-4xl font-bold text-primaryText text-center mb-12 capitalize p-10">
            @(exercise?.Name ?? titleFallback)
        </h1>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start lg:items-center">

            <div class="flex justify-center">
                <img src="@exercise?.GifUrl" alt="" class="w-full max-w-[300px] h-auto object-contain" />
            </div>

            <div class="space-y-6 text-primaryText p-10">

                <div>
                    <p class="font-semibold mb-2">@bodyPartsLabel</p>
                    <div class="flex flex-wrap">
                        @if (exercise?.BodyParts != null && exercise.BodyParts.Any())
                        {
                            foreach (var item in exercise.BodyParts)
                            {
                                <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block mr-2 mb-2">
                                    @item
                                </span>
                            }
                        }
                        else
                        {
                            <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block">
                                @notAvailable
                            </span>
                        }
                    </div>
                </div>

                <div>
                    <p class="font-semibold mb-2">@targetMusclesLabel</p>
                    <div class="flex flex-wrap">
                        @if (exercise?.TargetMuscles != null && exercise.TargetMuscles.Any())
                        {
                            foreach (var item in exercise.TargetMuscles)
                            {
                                <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block mr-2 mb-2">
                                    @item
                                </span>
                            }
                        }
                        else
                        {
                            <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block">
                                @notAvailable
                            </span>
                        }
                    </div>
                </div>

                <div>
                    <p class="font-semibold mb-2">@equipmentLabel</p>
                    <div class="flex flex-wrap">
                        @if (exercise?.Equipments != null && exercise.Equipments.Any())
                        {
                            foreach (var item in exercise.Equipments)
                            {
                                <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block mr-2 mb-2">
                                    @item
                                </span>
                            }
                        }
                        else
                        {
                            <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block">
                                @notAvailable
                            </span>
                        }
                    </div>
                </div>

                <div>
                    <p class="font-semibold mb-2">@secondaryMusclesLabel</p>
                    <div class="flex flex-wrap">
                        @if (exercise?.SecondaryMuscles != null && exercise.SecondaryMuscles.Any())
                        {
                            foreach (var item in exercise.SecondaryMuscles)
                            {
                                <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block mr-2 mb-2">
                                    @item
                                </span>
                            }
                        }
                        else
                        {
                            <span class="uppercase px-2 py-1 bg-primary/20 text-primaryText text-xs rounded-full font-medium inline-block">
                                @notAvailable
                            </span>
                        }
                    </div>
                </div>

            </div>

        </div>

        <div class="mt-14 border-t p-10">
            <h3 class="text-3xl font-semibold text-primaryText mb-6">@instructionsLabel</h3>

            @if (instructions.Any())
            {
                <div class="space-y-4 text-primaryText text-lg leading-relaxed">
                    @foreach (var step in instructions)
                    {
                        var formattedStep = System.Text.RegularExpressions.Regex.Replace(step, @"Step\s*:?\s*(\d+)", "Step $1:");
                        <p>@formattedStep</p>
                    }
                </div>
            }
            else
            {
                <p class="text-primaryText text-lg">@notAvailable</p>
            }
        </div>

    </div>
</div>
