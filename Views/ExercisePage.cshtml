@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ExercisePage>
@{
    Layout = "mainLayout.cshtml";

    var exercise = ViewData["Exercise"] as WorkoutProgramBuilder.Business.Dto.ExerciseDto;


    var titleFallback = Model.Title;
    var bodyPartsLabel = Model.BodyParts;
    var targetMusclesLabel = Model.TargetMuscles;
    var equipmentLabel = Model.Equipment;
    var secondaryMusclesLabel = Model.SecondaryMuscles;
    var instructionsLabel = Model.Instructions;
    var notAvailable = Model.NotAvailable;


    var instructions = exercise?.Instructions ?? [];

    string? ListOrFallback(List<string>? list) => list != null && list.Any() ? string.Join(", ", list) : notAvailable;
}

<div class="container mx-auto px-6 py-16">
    <div class="border bg-white shadow-sm border-primaryBorder rounded-xl">
        <h1 class="text-4xl font-bold text-primaryText text-center mb-10 capitalize">
            @(exercise?.Name ?? titleFallback)
        </h1>

        <div class="flex flex-col md:flex-row items-start md:items-center gap-8 mb-8">
            <div class="flex-shrink-0">
                <img src="@exercise?.GifUrl" alt="" class="w-64 h-64 object-contain" />
            </div>

            <div class="flex-1 space-y-3 text-primaryText">
                <p>
                    <span class="font-semibold">@bodyPartsLabel </span>
                    <span class="text-primary capitalize">@ListOrFallback(exercise?.BodyParts)</span>
                </p>
                <p>
                    <span class="font-semibold">@targetMusclesLabel </span>
                    <span class="text-primary capitalize">@ListOrFallback(exercise?.TargetMuscles)</span>
                </p>
                <p>
                    <span class="font-semibold">@equipmentLabel </span>
                    <span class="text-primary capitalize">@ListOrFallback(exercise?.Equipments)</span>
                </p>
                <p>
                    <span class="font-semibold">@secondaryMusclesLabel </span>
                    <span class="text-primary capitalize">@ListOrFallback(exercise?.SecondaryMuscles)</span>
                </p>
            </div>
        </div>

        <div class="mt-6 text-primaryText">
            <div class="p-8 md:p-12 bg-primaryGray space-y-3">
            <h3 class="text-2xl font-semibold text-primaryText mb-3">@instructionsLabel</h3>
            @if (instructions.Any())
            {

                    @foreach (var step in instructions)
                    {
                    var formattedStep = System.Text.RegularExpressions.Regex.Replace(step, @"Step\s*:?\s*(\d+)", "Step $1:");
                    <p>@formattedStep</p>
                }
            }
            else
            {
                <p>@notAvailable</p>
            }
        </div>
        </div>
    </div>
</div>
