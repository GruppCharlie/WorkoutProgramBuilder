@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "mainLayout.cshtml";

    var exercise = ViewData["Exercise"] as WorkoutProgramBuilder.Business.Dto.ExerciseDto;


    var titleFallback = Model.Value("title")?.ToString();
    var bodyPartsLabel = Model.Value("bodyParts")?.ToString() ?? "";
    var targetMusclesLabel = Model.Value("targetMuscles")?.ToString() ?? "";
    var equipmentLabel = Model.Value("equipment")?.ToString() ?? "";
    var secondaryMusclesLabel = Model.Value("secondaryMuscles")?.ToString() ?? "";
    var instructionsLabel = Model.Value("instructions")?.ToString() ?? "";
    var notAvailable = Model.Value("notAvailable")?.ToString() ?? "Not available";

    var instructions = exercise?.Instructions ?? new List<string>();

    string ListOrFallback(List<string>? list) => (list != null && list.Any()) ? string.Join(", ", list) : notAvailable;
}

<div class="container mx-auto px-6 py-10">
    <div class="bg-white shadow-lg rounded-xl p-8 md:p-12">
        <h1 class="text-4xl font-bold text-gray-700 text-center mb-10">
            @(exercise?.Name ?? titleFallback)
        </h1>

        <div class="flex flex-col md:flex-row items-start md:items-center gap-8 mb-8">
            <div class="flex-shrink-0">
                <img src="@exercise?.GifUrl" alt="" class="w-64 h-64 object-contain rounded-lg border border-gray-200" />
            </div>

            <div class="flex-1 space-y-3 text-gray-800">
                <p>
                    <span class="font-semibold text-gray-700">@bodyPartsLabel </span>
                    <span class="text-primary">@ListOrFallback(exercise?.BodyParts)</span>
                </p>
                <p>
                    <span class="font-semibold text-gray-700">@targetMusclesLabel </span>
                    <span class="text-primary">@ListOrFallback(exercise?.TargetMuscles)</span>
                </p>
                <p>
                    <span class="font-semibold text-gray-700">@equipmentLabel </span>
                    <span class="text-primary">@ListOrFallback(exercise?.Equipments)</span>
                </p>
                <p>
                    <span class="font-semibold text-gray-700">@secondaryMusclesLabel </span>
                    <span class="text-primary">@ListOrFallback(exercise?.SecondaryMuscles)</span>
                </p>
            </div>
        </div>

        <div class="mt-6 space-y-3 text-gray-700">
            <h3 class="text-2xl font-semibold text-gray-800 mb-3">@instructionsLabel</h3>
            @if (instructions.Any())
            {
                <ol class="list-decimal list-inside">
                    @foreach (var step in instructions)
                    {
                        <li>@step</li>
                    }
                </ol>
            }
            else
            {
                <p>@notAvailable</p>
            }
        </div>
    </div>
</div>
